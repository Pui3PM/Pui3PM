+
+// ---------- F04 / M03 + native null coercion : native writer path ----------
+async function nativeWriterScenario(){
+  const records=new Map(),key=(s,id,r)=>`${s}:${id}:${r}`,rel=100000,sid=1,shotId=2;
+  const clone=x=>JSON.parse(JSON.stringify(x));
